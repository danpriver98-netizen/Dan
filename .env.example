# ─────────────────────────────────────────────────────────────
# Real-Estate 360° CRM — Environment Configuration
# Copy to .env.local and fill in real values to enable Supabase.
# The app runs fully on MOCK DATA when these are absent.
# ─────────────────────────────────────────────────────────────

# Supabase (Auth / Database / Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta) — mocked when absent
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Cloud PBX / VoIP — mocked when absent
PBX_API_KEY=
PBX_RECORDING_BASE_URL=

# PropTech external listing feed — mocked when absent
PROPTECH_API_KEY=

# Cron protection (renter 11-month trigger, rolling tasks)
CRON_SECRET=local-dev-secret
